@model test.Models.MonAn
@{
    ViewData["Title"] = "Thêm món ăn";
}

<div class="page-header">
    <h2>🍳 Thêm món ăn mới</h2>
</div>

<div class="card card-food p-4" style="max-width: 500px;">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <div class="mb-3">
            <label class="form-label fw-bold">Tên món</label>
            <input asp-for="TenMon" class="form-control" placeholder="VD: Phở bò tái" />
            <span asp-validation-for="TenMon" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Giá (đ)</label>
            <input asp-for="Gia" class="form-control" placeholder="VD: 45000" />
            <span asp-validation-for="Gia" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Danh mục</label>
            <select asp-for="MaDanhMuc" class="form-control">
                <option value="">-- Chọn danh mục --</option>
                @foreach (var dm in (List<test.Models.DanhMuc>)ViewBag.DanhMucList)
                {
                    <option value="@dm.MaDanhMuc">@dm.TenDanhMuc</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Hình ảnh món ăn</label>
            <input type="file" name="anhUpload" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
        </div>
        <button type="submit" class="btn btn-restaurant w-100">Lưu món ăn</button>
    </form>
</div>
<a asp-action="Index" class="d-inline-block mt-3">← Quay lại quản lý thực đơn</a>
