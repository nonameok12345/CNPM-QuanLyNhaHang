@model test.Models.DangKyViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="page-header">
    <h2>📝 Đăng ký tài khoản</h2>
</div>

<div class="card card-food p-4" style="max-width: 460px;">
    <form asp-action="DangKy" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label class="form-label fw-bold">Họ và tên</label>
            <input asp-for="HoTen" class="form-control" autocomplete="name" />
            <span asp-validation-for="HoTen" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Số điện thoại <span class="text-muted fw-normal">(dùng để đăng nhập)</span></label>
            <input asp-for="SDT" class="form-control" placeholder="VD: 0901234567" autocomplete="tel" />
            <span asp-validation-for="SDT" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Email <span class="text-muted fw-normal">(không bắt buộc)</span></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Mật khẩu</label>
            <input asp-for="MatKhau" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="MatKhau" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Nhập lại mật khẩu</label>
            <input asp-for="NhapLaiMatKhau" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NhapLaiMatKhau" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-restaurant w-100">Tạo tài khoản</button>
    </form>
</div>

<p class="mt-3">
    Đã có tài khoản?
    <a asp-action="DangNhap" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập</a>
</p>
