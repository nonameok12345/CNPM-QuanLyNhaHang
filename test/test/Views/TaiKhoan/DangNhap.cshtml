@model test.Models.DangNhapKhachViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="page-header">
    <h2>🔐 Đăng nhập</h2>
</div>

<div class="card card-food p-4" style="max-width: 420px;">
    <form asp-action="DangNhap" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label class="form-label fw-bold">Số điện thoại</label>
            <input asp-for="SDT" class="form-control" autocomplete="tel" />
            <span asp-validation-for="SDT" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Mật khẩu</label>
            <input asp-for="MatKhau" type="password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="MatKhau" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-restaurant w-100">Đăng nhập</button>
    </form>
</div>

<p class="mt-3 mb-1">
    Chưa có tài khoản?
    <a asp-action="DangKy" asp-route-returnUrl="@Model.ReturnUrl">Đăng ký ngay</a>
</p>
<p class="text-muted small">
    Bạn là nhân viên? <a asp-controller="Account" asp-action="Login">Đăng nhập tại đây</a>
</p>
