@model test.Models.PhieuNhap
@{
    ViewData["Title"] = $"Phiếu nhập #{Model.MaNhap}";
}

<div class="page-header">
    <h2>📥 Phiếu nhập #@Model.MaNhap</h2>
    <p class="mb-0 text-muted">
        @Model.NgayNhap.ToString("dd/MM/yyyy HH:mm") · Nhân viên lập: @Model.NhanVien.HoTen · @Model.TrangThai
    </p>
</div>

@if (TempData["ThongBao"] is string thongBao)
{
    <div class="alert alert-success">@thongBao</div>
}

<div class="table-responsive">
    <table class="table align-middle bg-white">
        <thead>
            <tr>
                <th>Nguyên liệu</th>
                <th class="text-end">Số lượng</th>
                <th class="text-end">Đơn giá</th>
                <th class="text-end">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.ChiTiets.OrderBy(c => c.NguyenLieu.TenNL))
            {
                <tr>
                    <td class="fw-semibold">@c.NguyenLieu.TenNL</td>
                    <td class="text-end">@c.SoLuong.ToString("0.##") @c.NguyenLieu.DonViTinh</td>
                    <td class="text-end">@String.Format("{0:N0} đ", c.DonGia)</td>
                    <td class="text-end">@String.Format("{0:N0} đ", c.ThanhTien)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Tổng tiền</th>
                <th class="text-end price-tag">@String.Format("{0:N0} đ", Model.TongTien)</th>
            </tr>
        </tfoot>
    </table>
</div>

<a asp-action="Index" class="btn btn-outline-secondary">← Danh sách phiếu</a>
<a asp-action="Tao" class="btn btn-restaurant">+ Lập phiếu mới</a>
